{
  "expo": {
    "name": "Healing Breath",
    "slug": "healing-breath",
    "version": "1.0.0",
    "description": "Simple Techniques to Reduce Stress and Anxiety, Enhance Concentration, and Balance Your Emotions",
    "backgroundColor": "#000000",
    "orientation": "portrait",
    "androidStatusBar": {
      "hidden": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eatthetoad.breathe",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.eattthetoad.breathe",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "inset-swipe",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac8c5104-3738-4faf-a614-72a36e0f6c99"
      },
      "expo-navigation-bar": {
        "position": "absolute",
        "visibility": "hidden",
        "behavior": "inset-swipe",
        "backgroundColor": "#000000"
      }
    },
    "owner": "eatthetoad"
  }
}
